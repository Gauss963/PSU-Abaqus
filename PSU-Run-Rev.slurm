#!/bin/bash
#SBATCH --account=MST113389
#SBATCH --partition=ct112
#SBATCH --job-name=BlockJob-Rev
#SBATCH --output=/home/gauss112/outs/Abaqus-%j.out
#SBATCH --error=/home/gauss112/outs/Abaqus-%j.err
#SBATCH --ntasks=20
#SBATCH --cpus-per-task=1
#SBATCH --nodes=1
#SBATCH --time=95:30:00
#SBATCH --mem=320G
#SBATCH --mail-type=ALL
#SBATCH --mail-user=b09501028@ntu.edu.tw

echo "Job started at $(date) on $(hostname)"

cd /home/gauss112/abaqus
source /etc/profile.d/modules.sh
module load apps/abaqus/2024

# === Unset SLURM_GTIDS for Abaqus MPI compatibility ===
unset SLURM_GTIDS

# === Generate abaqus_v6.env dynamically ===
env_file=abaqus_v6.env
node_list=$(scontrol show hostname ${SLURM_NODELIST} | sort -u)

mp_host_list="["
for host in ${node_list}; do
    mp_host_list="${mp_host_list}['$host', 20],"
done
mp_host_list=$(echo ${mp_host_list} | sed -e "s/,\$/]/")

echo "mp_host_list=${mp_host_list}" > ${env_file}
echo "max_history_requests = 0" >> ${env_file}
echo "# Generated by Slurm job at $(date)" >> ${env_file}

# === Step 1: Generate all input files via PSU-Make.py ===
abaqus cae noGUI=PSU-Make-All-Rev.py

# === Step 2: Run all input jobs ===
for pos in 140 130 120 110 100 90 80 70 60; do
    jobname="BlockJob-Rev-${pos}"
    echo "Running Abaqus job ${jobname} at $(date)"
    abaqus job=${jobname} cpus=20 mp_mode=mpi interactive
    echo "Completed ${jobname} at $(date)"
done

echo "All Abaqus jobs completed at $(date)"

DATE_STR=$(date +"%Y-%m-%d-%H-%M-%S")
DEST_DIR="/home/gauss112/Documents/ELSE.odbs/$DATE_STR"
mkdir -p "$DEST_DIR"
mv /home/gauss112/abaqus/*.odb "$DEST_DIR"

cp /home/gauss112/Documents/ELSE.odbs/read-odb-rev.py "$DEST_DIR"
cp /home/gauss112/Documents/ELSE.odbs/read-npz-rev.py "$DEST_DIR"
cp /home/gauss112/Documents/ELSE.odbs/read-shear-rev.py "$DEST_DIR"
cd "$DEST_DIR"
abaqus python ./read-odb-rev.py

module load tools/miniconda3
conda deactivate
conda activate PSU-FEM
python ./read-npz-rev.py

abaqus python ./read-shear-rev.py