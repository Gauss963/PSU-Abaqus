#!/bin/bash
#SBATCH --account=MST113389
#SBATCH --partition=ct112
#SBATCH --job-name=1x-10MPa-DC-0.5mm
#SBATCH --output=/home/gauss112/outs/Abaqus-%j.out
#SBATCH --error=/home/gauss112/outs/Abaqus-%j.err
#SBATCH --ntasks=96
#SBATCH --cpus-per-task=1
#SBATCH --nodes=1
#SBATCH --time=95:30:00
#SBATCH --mem=400G
#SBATCH --mail-type=ALL
#SBATCH --mail-user=b09501028@ntu.edu.tw

echo "Job started at $(date) on $(hostname)"

# === Create unique working directory ===
# Use SLURM_JOB_ID to ensure uniqueness
WORK_DIR="/home/gauss112/abaqus/work_${SLURM_JOB_ID}_$(date +%Y%m%d_%H%M%S)_$$"
mkdir -p "$WORK_DIR"
echo "Working directory: $WORK_DIR"

# Copy necessary files to working directory
# (You may need to adjust this based on what files PSU-Make-DC.py needs)
cp /home/gauss112/abaqus/PSU-Make-DC.py "$WORK_DIR/" 2>/dev/null || true
# Add any other required input files here
# cp /home/gauss112/abaqus/your_other_files "$WORK_DIR/"

# Change to working directory
cd "$WORK_DIR"

source /etc/profile.d/modules.sh
module load apps/abaqus/2024

# === Unset SLURM_GTIDS for Abaqus MPI compatibility ===
unset SLURM_GTIDS

# === Step 0: Generate abaqus_v6.env dynamically ===
env_file=abaqus_v6.env
node_list=$(scontrol show hostname ${SLURM_NODELIST} | sort -u)

mp_host_list="["
for host in ${node_list}; do
    mp_host_list="${mp_host_list}['$host', 20],"
done
mp_host_list=$(echo ${mp_host_list} | sed -e "s/,\$/]/")

echo "mp_host_list=${mp_host_list}" > ${env_file}
echo "max_history_requests = 0" >> ${env_file}
echo "# Generated by Slurm job at $(date)" >> ${env_file}

# === Step 1: Generate all input files via PSU-Make.py ===
abaqus cae noGUI=PSU-Make-DC.py

# === Step 2: Run all input jobs ===
for pos in 115 110 105 100 95 90 85 80 75 65 55 45 35 25 15 5; do
    jobname="BlockJob-${pos}"
    echo "Running Abaqus job ${jobname} at $(date)"
    abaqus job=${jobname} cpus=20 mp_mode=mpi interactive
    echo "Completed ${jobname} at $(date)"
done

echo "All Abaqus jobs completed at $(date)"

# === Step 3: Post processing ===
DATE_STR=$(date +"%Y-%m-%d-%H-%M-%S")
DEST_DIR="/home/gauss112/Documents/ELSE.odbs/$DATE_STR"
mkdir -p "$DEST_DIR"

# Move ODB files from working directory
mv "$WORK_DIR"/*.odb "$DEST_DIR" 2>/dev/null || true

cp /home/gauss112/Documents/ELSE.odbs/read-odb.py "$DEST_DIR"
cp /home/gauss112/Documents/ELSE.odbs/read-npz.py "$DEST_DIR"
cp /home/gauss112/Documents/ELSE.odbs/read-shear.py "$DEST_DIR"
cp /home/gauss112/Documents/ELSE.odbs/read-shear-Ke.py "$DEST_DIR"
cp /home/gauss112/Documents/ELSE.odbs/read-shear-to-npz.py "$DEST_DIR"

cd "$DEST_DIR"
abaqus python ./read-odb.py

module load tools/miniconda3
conda deactivate
conda activate PSU-FEM
python ./read-npz.py
abaqus python ./read-shear-to-npz.py
abaqus python ./read-shear.py
abaqus python ./read-shear-Ke.py

# === Optional: Clean up working directory ===
# Remove temporary working directory after successful completion
# Uncomment the following lines if you want automatic cleanup
echo "Cleaning up working directory: $WORK_DIR"
rm -rf "$WORK_DIR"

echo "Job completed successfully at $(date)"