#!/bin/bash
#SBATCH --account=MST113389
#SBATCH --partition=ct112
#SBATCH --job-name=RuptureChunk
#SBATCH --output=/home/gauss112/Abaqus-%j.out
#SBATCH --error=/home/gauss112/Abaqus-%j.err
#SBATCH --ntasks=8
#SBATCH --cpus-per-task=1
#SBATCH --nodes=1
#SBATCH --time=48:00:00
#SBATCH --mem-per-cpu=16G
#SBATCH --mail-type=ALL
#SBATCH --mail-user=b09501028@ntu.edu.tw

echo "[INFO] Job started at $(date) on $(hostname)"
echo "[INFO] Running rupture index range: $INDEX_FROM ~ $INDEX_TO"

cd /home/gauss112/abaqus
source /etc/profile.d/modules.sh
module load apps/abaqus/2024
unset SLURM_GTIDS

env_file=abaqus_v6.env
node_list=$(scontrol show hostname ${SLURM_NODELIST} | sort -u)
mp_host_list="["
for host in ${node_list}; do
    mp_host_list="${mp_host_list}['$host', 8],"
done
mp_host_list=$(echo ${mp_host_list} | sed -e "s/,\$/]/")
echo "mp_host_list=${mp_host_list}" > ${env_file}
echo "# Generated by Slurm job at $(date)" >> ${env_file}

for (( i=${INDEX_FROM}; i<=${INDEX_TO}; i++ )); do
    RUPTURE_POSITION=$(echo "scale=4; 75.0 * $i / 99" | bc)
    JOBNAME=$(printf "BlockJob-%.2f" ${RUPTURE_POSITION})

    echo "[INFO] Generating index $i → ${JOBNAME}"
    echo "[INFO] Command: abaqus cae noGUI=PSU-Make.py -- ${i}"

    abaqus cae noGUI=PSU-Make.py -- ${i}
    abaqus job=${JOBNAME} cpus=8 mp_mode=mpi interactive
done

echo "[INFO] Chunk job completed at $(date)"